      }
    },
    {
      "id": "sentiment_s03_text_unfreeze_top2",
      "args": {
        "loss-type": "ce",
        "emotion-class-weight-strategy": "none",
        "sentiment-class-weight-strategy": "none",
        "text-unfreeze-layers": 2,
        "text-lr": 8e-6,
        "selection-metric": "sentiment_macro_f1"
      }
